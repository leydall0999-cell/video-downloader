{
  "manifest_version": 3,
  "name": "VideoDownloader 媒体嗅探",
  "version": "1.0.0",
  "description": "嗅探网页中的视频 / 音频 / HLS 清单，一键发给 VideoDownloader 桌面端下载。仅监听请求头，数据只发往本机桌面端。",
  "permissions": [
    "webRequest",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "VideoDownloader 媒体嗅探",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
