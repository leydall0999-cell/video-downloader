# deploy/.env — 部署时传给 remote_setup.sh 的配置
# 用法: bash deploy/remote_setup.sh root@<IP> deploy/.env
#
# VDL_PROXY_CN: 国内阿里云 ECS 上 cn_proxy 的回源地址（让境外 VPS 能下 B站/抖音等国内平台）
#   留空即可——remote_setup.sh 会自动 SSH 到 8.138.223.3 读取 cn_proxy 凭据并填入。
#   如需手动指定：http://<user>:<pass>@8.138.223.3:18888
VDL_PROXY_CN=

# VDL_INSTANCE: cloud = 网页形态（默认，一般不用改）
VDL_INSTANCE=cloud

# VDL_HTTP_PORT: 网页服务监听端口（默认 8080，无需改动）。
#   8080 在 Cloudflare 橙云回源白名单内，域名可直接指过来。
#   若云厂商防火墙不放行 8080，可改成已放行的端口，例如：80 / 8888 / 443
# VDL_HTTP_PORT=8080

# VDL_DOMAIN: 站点域名。填了才会在部署末尾给出 https://<域名> 提示，
#   并用作 nginx 自签证书的 CN/SAN。推荐填 hanyuxz.top。
#   注意 Cloudflare 侧：A 记录指向本机公网 IP、保持「已代理(橙云)」，
#   且 SSL/TLS 模式为 Full（非 Full-strict，否则自签证书会 526）。
VDL_DOMAIN=hanyuxz.top

# VDL_TUNNEL_TOKEN: 反向隧道 (/ws/cn-tunnel) 的共享密钥。
#   必须与国内 ECS 的 cn_tunnel_client 的 VDL_TUNNEL_TOKEN 完全一致，
#   否则隧道握手被拒 → 桌面 App 那 14 个平台解析全部失效。
#   不填 = 用 server/cn_tunnel.py 的内置默认值。
# VDL_TUNNEL_TOKEN=

# VDL_COOKIE_SYNC_TOKEN: 桌面 App 的同步 token（App 侧在
#   ~/.videodownloader/cloud_sync.json 的 "token" 字段）。
#   本机服务用它给 /v1/resolve 与 cookie 同步端点鉴权；不填则这些端点一律 403。
# ⚠️ 这是凭证 —— 本文件（deploy/.env）已被 .gitignore 覆盖，不要提交到仓库。
# VDL_COOKIE_SYNC_TOKEN=
